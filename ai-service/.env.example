# Copy to ai-service/.env for local development.
# CRITICAL: DATABASE_URL must use the SAME database as the project root .env.local.
# A mismatch causes "AI service error: 500" (or 404) when starting a questionnaire
# because audit_sessions.user_id references users — Next.js writes users, AI service
# must read/write the same Postgres database.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/raivan_global?schema=public"
GEMINI_API_KEY=""
ENCRYPTION_KEY=""
ALLOW_INSECURE_LOCAL=true
