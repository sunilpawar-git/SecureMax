# Copy to ai-service/.env for local development.
#
# CRITICAL: All DATABASE_*_URL values must point to the SAME database as the
# project root .env.local (raivan_global). A mismatch causes "User not found"
# (404) when starting a questionnaire because audit_sessions.user_id foreign-
# keys into users — Next.js writes users, the AI service must query the same DB.

# Database URLs (role-based access control — all point to the same database)
DATABASE_READ_URL="postgresql://ai_readonly:<password>@localhost:5432/raivan_global"
DATABASE_WRITE_URL="postgresql://app_user:<password>@localhost:5432/raivan_global"
SCRAPER_DATABASE_URL="postgresql://scraper_user:<password>@localhost:5432/raivan_global"
DATABASE_URL="postgresql://app_user:<password>@localhost:5432/raivan_global"

# AI
GEMINI_API_KEY=""
GEMINI_REGION="asia-south1"

# Service
ENCRYPTION_KEY=""
ALLOW_INSECURE_LOCAL=true
DEV_BYPASS_SESSION_CHECK=true

# Admin
ADMIN_EMAIL=""
NEWS_API_KEY=""
