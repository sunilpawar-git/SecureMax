{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest"]
    }
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit.*\\.(ts|tsx|js|jsx)$",
        "command": "npx prettier --write '{file}' 2>/dev/null || true",
        "description": "Auto-format TypeScript/JavaScript files"
      },
      {
        "matcher": "Edit.*\\.py$",
        "command": "cd ai-service && python -m black '{file}' 2>/dev/null || true",
        "description": "Auto-format Python files"
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash.*git commit",
        "command": "bash scripts/pre-commit-check.sh",
        "description": "Lint, type-check, and verify before commit (exit code 2 = block)"
      },
      {
        "matcher": "Bash.*git commit",
        "command": "bash scripts/check-secrets.sh",
        "description": "Detect API keys, tokens, credentials before commit (blocks on secrets found)"
      },
      {
        "matcher": "Bash.*git commit",
        "command": "bash scripts/validate-yaml.sh",
        "description": "Validate question graph YAML for orphans, dead ends, missing refs"
      }
    ]
  }
}
