# ===========================================================================
# Raivan Global Security Crawler — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.
# ===========================================================================

# ─── Database ───────────────────────────────────────────────────────────────
# Production: append ?sslmode=require to enforce TLS connections
# Next.js (Prisma) and ai-service/.env MUST use the same database name.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/raivan_global"

# ─── NextAuth ───────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# ─── Google OAuth ───────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Microsoft Entra ID (Azure AD) — optional for enterprise SSO ───────────
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""

# ─── Admin ──────────────────────────────────────────────────────────────────
# Email address that gets auto-promoted to admin role on first login
ADMIN_EMAIL=""

# ─── AI Service (FastAPI) ──────────────────────────────────────────────────
AI_SERVICE_URL="http://localhost:8000"
AI_SERVICE_KEY="generate-a-secure-random-key"

# ─── Gemini API ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=""

# ─── RazorPay (HNI payments) ───────────────────────────────────────────────
RAZORPAY_KEY_ID=""
RAZORPAY_SECRET=""

# ─── Encryption (AES-256-GCM for session data) ─────────────────────────────
# Must be exactly 32 bytes (64 hex chars): openssl rand -hex 32
ENCRYPTION_KEY=""
ENCRYPTION_KEY_VERSION=1

# ─── Email (Resend) — optional, for enterprise lead emails ─────────────────
RESEND_API_KEY=""

# ─── Web Scraper (security news ingestion) ──────────────────────────────────
NEWS_API_KEY=""

# ─── LinkedIn (admin social posting) ──────────────────────────────────────
LINKEDIN_ACCESS_TOKEN=""

# ─── CORS (FastAPI) ────────────────────────────────────────────────────────
CORS_ORIGINS="http://localhost:3000"

# ─── Cloudflare Turnstile (bot protection on public forms) ──────────────────
# Server-side secret (verifies tokens). Leave blank in dev to skip verification.
TURNSTILE_SECRET_KEY=""
# Public site key — exposed to the browser (not a secret).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# ─── Rate limiting (distributed) ────────────────────────────────────────────
# Set both to enable Redis-backed limits across instances. Leave blank to use
# the in-memory limiter (single instance / dev).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
