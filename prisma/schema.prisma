generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

// ========== USERS ==========

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  image         String?
  role          String   @default("user")
  track         String   @default("hni")
  orgName       String?  @map("org_name")
  logoUrl       String?  @map("logo_url")
  consentAt      DateTime? @map("consent_at")
  consentVersion String?   @map("consent_version")
  consentPurpose String?   @map("consent_purpose")
  anonymisedAt   DateTime? @map("anonymised_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  accounts      Account[]
  sessions      Session[]
  auditSessions AuditSession[]
  adminActions  AdminAction[]

  @@map("users")
}

// ========== NEXTAUTH ACCOUNTS ==========

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refreshToken      String? @map("refresh_token") @db.Text
  accessToken       String? @map("access_token") @db.Text
  expiresAt         Int?    @map("expires_at")
  tokenType         String? @map("token_type")
  scope             String?
  idToken           String? @map("id_token") @db.Text
  sessionState      String? @map("session_state")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ========== AUDIT SESSIONS ==========

model AuditSession {
  id                        String    @id @default(cuid())
  userId                    String    @map("user_id")
  track                     String    @default("hni")
  status                    String    @default("in_progress")
  propertyType              String?   @map("property_type")
  facilityType              String?   @map("facility_type")
  currentNodeId             String?   @map("current_node_id")
  domainScores              Json?     @map("domain_scores")
  moduleScores              Json?     @map("module_scores")
  paid                      Boolean   @default(false)
  razorpayOrderId           String?   @unique @map("razorpay_order_id")
  ndaAcceptedAt             DateTime? @map("nda_accepted_at")
  reportReady               Boolean   @default(false) @map("report_ready")
  enterpriseReportUnlocked  Boolean   @default(false) @map("enterprise_report_unlocked")
  postDownloadFollowupAt    DateTime? @map("post_download_followup_at")
  downloadedAt              DateTime? @map("downloaded_at")
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  events         SessionEvent[]
  reportArtifact ReportArtifact?
  reportJob      ReportJob?

  @@index([userId, status])
  @@map("audit_sessions")
}

// ========== SESSION EVENTS (immutable audit trail) ==========

model SessionEvent {
  id              String    @id @default(cuid())
  sessionId       String    @map("session_id")
  questionNodeId  String    @map("question_node_id")
  answerEncrypted String    @map("answer_encrypted") @db.Text
  aiReasoningEncrypted String? @map("ai_reasoning_encrypted") @db.Text
  cppCitations    Json?     @map("cpp_citations")
  complianceTags  Json?     @map("compliance_tags")
  domainScoreDelta Json?    @map("domain_score_delta")
  moduleScoreDelta Json?    @map("module_score_delta")
  anonymisedAt    DateTime? @map("anonymised_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  session AuditSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, questionNodeId])
  @@index([sessionId])
  @@map("session_events")
}

// ========== QUESTION NODES ==========

model QuestionNode {
  id           String  @id @default(cuid())
  domain       String
  text         String  @db.Text
  questionType String  @map("question_type")
  edges        Json
  cppDomainTag String  @map("cpp_domain_tag")
  track        String  @default("both")
  moduleTag    String? @map("module_tag")
  version      Int     @default(1)
  isTerminal   Boolean @default(false) @map("is_terminal")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([track, domain])
  @@map("question_nodes")
}

// ========== CPP CHUNKS (pgvector embeddings) ==========

model CppChunk {
  id          String                      @id @default(cuid())
  domain      String
  section     String
  chunkText   String                      @map("chunk_text") @db.Text
  embedding   Unsupported("vector(3072)")
  contentHash String                      @unique @map("content_hash")
  createdAt   DateTime                    @default(now()) @map("created_at")

  @@index([domain])
  @@map("cpp_chunks")
}

// ========== THREAT INTEL ==========

model ThreatIntel {
  id           String   @id @default(cuid())
  title        String
  url          String   @unique
  contentHash  String   @unique @map("content_hash")
  summary      String   @db.Text
  domainTags   Json     @map("domain_tags")
  industryTags Json     @map("industry_tags")
  source         String   @default("unknown")
  relevanceScore Float    @default(0.0) @map("relevance_score")
  usedInReports  Boolean  @default(false) @map("used_in_reports")
  softDeleted    Boolean  @default(false) @map("soft_deleted")
  scrapedAt      DateTime @default(now()) @map("scraped_at")

  @@index([softDeleted])
  @@map("threat_intel")
}

// ========== LINKEDIN POSTS ==========

model LinkedinPost {
  id            String    @id @default(cuid())
  draftText     String    @map("draft_text") @db.Text
  finalText     String?   @map("final_text") @db.Text
  status        String    @default("draft")
  postedAt      DateTime? @map("posted_at")
  platform      String    @default("linkedin")
  postedByAdmin String?   @map("posted_by_admin_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("linkedin_posts")
}

// ========== REPORT ARTIFACTS ==========

model ReportArtifact {
  id                    String   @id @default(cuid())
  sessionId             String   @unique @map("session_id")
  pdfEncrypted          Bytes    @map("pdf_encrypted")
  auditUrgencyScore     Int      @map("audit_urgency_score")
  peerBenchmarkPctile   Float    @map("peer_benchmark_percentile")
  complianceGapCount    Int?     @map("compliance_gap_count")
  findingsJson          Json?    @map("findings_json")
  version               Int      @default(1)
  previousId            String?  @map("previous_id")
  generatedAt           DateTime @default(now()) @map("generated_at")

  session AuditSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("report_artifacts")
}

// ========== REPORT JOBS (async generation tracking) ==========

model ReportJob {
  id           String   @id @default(uuid())
  sessionId    String   @unique @map("session_id")
  status       String   @default("pending")
  errorMessage String?  @map("error_message")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  session AuditSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("report_jobs")
}

// ========== ENTERPRISE LEADS ==========

model EnterpriseLead {
  id               String   @id @default(cuid())
  name             String
  designation      String?
  company          String
  facilitiesCount  Int?     @map("facilities_count")
  cities           String?
  preferredContact String?  @map("preferred_contact")
  email            String?
  sourceSessionId  String?  @map("source_session_id")
  status           String   @default("new")
  lastEmailSentAt  DateTime? @map("last_email_sent_at")
  followUpDueAt    DateTime? @map("follow_up_due_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  followUpReminders FollowUpReminder[]

  @@index([status])
  @@map("enterprise_leads")
}

// ========== ADMIN ACTIONS (immutable audit trail) ==========

model AdminAction {
  id         String   @id @default(cuid())
  adminId    String   @map("admin_id")
  actionType String   @map("action_type")
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  admin      User     @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId, createdAt])
  @@index([entityType, entityId])
  @@map("admin_actions")
}

// ========== SCRAPER RUNS (persistent execution history) ==========

model ScraperRun {
  id             String    @id @default(cuid())
  source         String?
  status         String    @default("running")
  articlesFound  Int       @default(0) @map("articles_found")
  articlesStored Int       @default(0) @map("articles_stored")
  duplicates     Int       @default(0)
  errors         Json?
  startedAt      DateTime  @default(now()) @map("started_at")
  completedAt    DateTime? @map("completed_at")

  @@index([startedAt])
  @@map("scraper_runs")
}

// ========== FOLLOW-UP REMINDERS ==========

model FollowUpReminder {
  id          String         @id @default(cuid())
  leadId      String         @map("lead_id")
  dueAt       DateTime       @map("due_at")
  status      String         @default("pending")
  createdAt   DateTime       @default(now()) @map("created_at")
  completedAt DateTime?      @map("completed_at")

  lead        EnterpriseLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([status, dueAt])
  @@map("follow_up_reminders")
}

// ========== WEBHOOK LOGS ==========

model WebhookLog {
  id        String   @id @default(cuid())
  provider  String
  eventType String   @map("event_type")
  status    String   @default("success")
  errorLog  String?  @map("error_log") @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@index([provider, createdAt])
  @@map("webhook_logs")
}

// ========== API KEYS (Encrypted) ==========

model ApiKey {
  id              String   @id @default(cuid())
  provider        String   // "gemini", "openai", etc.
  keyNameEncrypted String  @map("key_name_encrypted") @db.Text
  keyEncrypted    String   @map("key_encrypted") @db.Text
  status          String   @default("active") // "active", "rotated", "revoked"
  lastUsedAt      DateTime? @map("last_used_at")
  createdAt       DateTime @default(now()) @map("created_at")
  rotatedAt       DateTime? @map("rotated_at")
  revokedAt       DateTime? @map("revoked_at")

  @@unique([provider, status]) // Only one active key per provider at a time
  @@index([provider, status])
  @@map("api_keys")
}

// ========== API KEY AUDIT LOG ==========

model ApiKeyAudit {
  id          String   @id @default(cuid())
  apiKeyId    String   @map("api_key_id")
  action      String   // "created", "used", "rotated", "revoked"
  actor       String?  // "system", "admin_email", etc.
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  status      String   @default("success") // "success", "failed"
  errorMsg    String?  @map("error_msg")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([apiKeyId, createdAt])
  @@index([action, createdAt])
  @@map("api_key_audits")
}
